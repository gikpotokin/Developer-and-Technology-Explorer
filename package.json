{
  "name": "developer-technology-explorer",
  "version": "1.0.0",
  "description": "API-powered web application for exploring developers, repositories, programming languages, and technology articles.",
  "type": "module",
  "main": "js/main.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.mjs",
    "format": "prettier --ignore-path ./.gitignore --write \"./**/*.{html,json,js,mjs,css}\""
  },
  "author": "Godswill Moses Ikpotokin",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.2.5",
    "vite": "^5.4.7"
  },
  "browserslist": [
    "last 3 and_chr versions",
    "last 3 chrome versions",
    "last 3 opera versions",
    "last 3 ios_saf versions",
    "last 3 safari versions"
  ]
}
